{
  "name": "coa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first, single-user governance/audit layer over a rented Claude Agent SDK loop.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm depcruise"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsdown": "0.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
