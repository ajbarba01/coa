# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# coa local (rebuildable projections / inferred graph half) + daemon runtime WAL
.coa/local/
.coa/wal/

# logs / os
*.log
.DS_Store
Thumbs.db

# editor
.idea/
.vscode/*
!.vscode/extensions.json

# env
.env
.env.*
!.env.example

# visual-companion brainstorm scratch
.superpowers/

# Scratch / redirect dumps (never committed — see AGENTS.md: scratch → scratchpad)
*-out.txt
test-out.txt
/TEMP.md
/LOCAL.md

# Local agent workspace: git worktrees, ad-hoc skills, settings — never committed.
# Contents are excluded rather than the directory itself: git cannot re-include a
# path whose parent directory is excluded, and the negation below depends on it.
.claude/*
# ...except skills the repo OWNS. `writing-in-voice` carries coa's derived copy
# profile and has to travel with the repo to be the source of truth it claims.
!.claude/skills/
